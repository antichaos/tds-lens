      </connection>
      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Region Group' datatype='string' name='[Calculation_0002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// map sales regions to reporting regions&#10;IF [Region] = &apos;North&apos; THEN &apos;North &amp; East&apos;&#10;ELSEIF [Region] = &apos;North-East&apos; THEN &apos;North &amp; East&apos;&#10;ELSEIF [Region] = &apos;East&apos; THEN &apos;North &amp; East&apos;&#10;ELSEIF [Region] = &apos;South-East&apos; THEN &apos;South&apos;&#10;ELSEIF [Region] = &apos;South&apos; THEN &apos;South&apos;&#10;ELSEIF [Region] = &apos;South-West&apos; THEN &apos;South&apos;&#10;ELSEIF [Region] = &apos;West&apos; THEN &apos;West&apos;&#10;ELSEIF [Region] = &apos;North-West&apos; THEN &apos;West&apos;&#10;ELSEIF [Region] = &apos;Central&apos; THEN &apos;Central&apos;&#10;ELSEIF [Region] = &apos;Mid-West&apos; THEN &apos;Central&apos;&#10;ELSEIF [Region] = &apos;Islands&apos; THEN &apos;Other&apos;&#10;ELSE &apos;Unknown&apos;&#10;END' />
      </column>
      <column caption='Order Date' datatype='date' name='[Calculation_0003]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&apos;yyyy-MM-dd&apos;, [Order Date Text])' />
      </column>
      <column caption='Order Month' datatype='date' name='[Calculation_0004]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_0003])' />
      </column>
      <column caption='Is Premium Product' datatype='boolean' name='[Calculation_0005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(LOWER([Product Name]), &apos;premium&apos;)&#10;OR REGEXP_MATCH([Product Name], &apos;(?i)\b(pro|deluxe)\b&apos;)' />
      </column>
      <column caption='Customer Sales' datatype='real' name='[Calculation_0006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer Name] : SUM([Sales]) }' />
      </column>
      <column caption='Customer Tier' datatype='string' name='[Calculation_0007]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0006] &gt;= 10000 THEN &apos;Gold&apos;&#10;ELSEIF [Calculation_0006] &gt;= 2500 THEN &apos;Silver&apos;&#10;ELSE &apos;Bronze&apos;&#10;END' />
      </column>
      <column caption='Avg Customer Sales per Region' datatype='real' name='[Calculation_0008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region] : AVG({ FIXED [Region], [Customer Name] : SUM([Sales]) }) }' />
      </column>
      <column caption='Running Sales' datatype='real' name='[Calculation_0009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Sales (3-period avg)' datatype='real' name='[Calculation_0010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_0009], -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Rank' datatype='integer' name='[Calculation_0011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='In Top N' datatype='boolean' name='[Calculation_0012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0011] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_0013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer Name])' />
      </column>
      <column caption='Days Since Order' datatype='integer' name='[Calculation_0014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_0003], TODAY())' />
      </column>
      <column caption='Margin %' datatype='real' name='[Calculation_0015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Calculation_0001] * 100, 1)' />
      </column>
      <column caption='Margin Band' datatype='string' name='[Calculation_0016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0015] &lt; 0 THEN &apos;Loss&apos;&#10;ELSEIF [Calculation_0015] &lt; 10 THEN &apos;Low&apos;&#10;ELSE &apos;Healthy&apos;&#10;END' />
      </column>
      <column caption='Margin Band Label' datatype='string' name='[Calculation_0017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0016] + &apos; margin&apos;' />
      </column>
      <column caption='Margin Band Sort' datatype='integer' name='[Calculation_0018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_0017]&#10;WHEN &apos;Loss margin&apos; THEN 1&#10;WHEN &apos;Low margin&apos; THEN 2&#10;ELSE 3&#10;END' />
      </column>
      <column caption='Order Year (old)' datatype='date' name='[Calculation_0019]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// replaced by Order Date, kept just in case&#10;DATE(MID([Order Date Text], 1, 4) + &apos;-01-01&apos;)' />
      </column>
      <column caption='Ship Delay (days)' datatype='integer' name='[Calculation_0020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_0003], [Ship Date])' />
      </column>
      <column caption='Segment Code' datatype='string' name='[Calculation_0021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(UPPER([Segment]), 3)' />
      </column>
      <column caption='Region Access' datatype='boolean' name='[Calculation_0022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISMEMBEROF(&apos;Sales &apos; + [Region])' />
      </column>
      <filter class='categorical' column='[Calculation_0022]'>
        <groupfilter function='member' level='[Calculation_0022]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Sales by Region'>
      <table>
        <view>
