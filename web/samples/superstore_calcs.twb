              <table-calc ordering-type='Rows' />
            </calculation>
          </column>
          <column-instance column='[Calculation_0002]' derivation='None' name='[none:Calculation_0002:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_0001]' derivation='User' name='[usr:Calculation_0001:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_0009]' derivation='User' name='[usr:Calculation_0009:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_0010]' derivation='User' name='[usr:Calculation_0010:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
        <filter class='categorical' column='[federated.1x7k2m00q9wz3a].[none:Calculation_0002:nk]'>
          <groupfilter function='member' level='[none:Calculation_0002:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
        </filter>
          <aggregation value='true' />
        </view>
