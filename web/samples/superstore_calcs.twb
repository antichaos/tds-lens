    <worksheet name='Order Details'>
      <table>
        <view>
          <datasources>
            <datasource caption='Superstore Orders' name='federated.1x7k2m00q9wz3a' />
          </datasources>
          <datasource-dependencies datasource='federated.1x7k2m00q9wz3a'>
          <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
          <column caption='Is Premium Product' datatype='boolean' name='[Calculation_0005]' role='dimension' type='nominal'>
            <calculation class='tableau' formula='CONTAINS(LOWER([Product Name]), &apos;premium&apos;)&#10;OR REGEXP_MATCH([Product Name], &apos;(?i)\b(pro|deluxe)\b&apos;)' />
          </column>
          <column caption='Days Since Order' datatype='integer' name='[Calculation_0014]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_0003], TODAY())' />
          </column>
          <column caption='Ship Delay (days)' datatype='integer' name='[Calculation_0020]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_0003], [Ship Date])' />
          </column>
          <column-instance column='[Order ID]' derivation='None' name='[none:Order ID:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_0005]' derivation='None' name='[none:Calculation_0005:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_0014]' derivation='Sum' name='[sum:Calculation_0014:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_0020]' derivation='Sum' name='[sum:Calculation_0020:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
