        <range granularity='1' max='50' min='1' />
      </column>
    </datasource>
    <datasource caption='Superstore Orders' inline='true' name='federated.1x7k2m00q9wz3a' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='dwh.example.com' name='postgres.0q2w3e4r5t6y7u'>
            <connection authentication='username-password' class='postgres' dbname='sales' one-time-sql='' port='5432' server='dwh.example.com' username='tableau_reader' />
